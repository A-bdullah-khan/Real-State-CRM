# =============================================================================
# Backend environment — copy to `backend/.env` and fill in the values.
#   cp .env.example .env
# config/settings.py loads this file automatically. Never commit the real .env.
# Booleans accept 1/true/yes/on (anything else is false). Lists are comma-separated.
# =============================================================================

# --- Django core -------------------------------------------------------------
# True for local development only. When False, DJANGO_SECRET_KEY is required and
# the production security settings below take effect.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Hostnames this server may answer to. Add your domain in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Server-side time zone (IANA name, e.g. America/Chicago). Datetimes are stored in UTC
# regardless; this affects "now" in AI prompts and the default follow-up schedule.
DJANGO_TIME_ZONE=UTC

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
DJANGO_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Leave unset to use SQLite at backend/db.sqlite3. Set to use PostgreSQL:
# DATABASE_URL=postgres://crm_user:crm_password@localhost:5432/real_estate_crm

# Seconds to keep database connections open between requests (0 = close after each).
DB_CONN_MAX_AGE=60

# --- REST API ----------------------------------------------------------------
# Page size for paginated list endpoints. The frontend also assumes 20 per page.
API_PAGE_SIZE=20

# Default DRF permission class. AllowAny leaves the API open; switch to
# rest_framework.permissions.IsAuthenticated once authentication is wired up.
DRF_DEFAULT_PERMISSION=rest_framework.permissions.AllowAny

# --- CORS / CSRF -------------------------------------------------------------
# Browser origins (scheme://host:port) allowed to call the API. Trailing slashes are ignored.
# 5174 is listed because Vite falls back to it when 5173 is already taken.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Origins Django accepts for unsafe requests (POST/PATCH/DELETE) when a session cookie is
# present, e.g. after logging into /admin in the same browser. The Vite proxy rewrites the
# Host header, so the dev server's own origin must be listed here or those requests fail
# with "CSRF Failed: Origin checking failed". Defaults to CORS_ALLOWED_ORIGINS when unset.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- AI engine (Groq) --------------------------------------------------------
# Powers the AI chat assistant and AI follow-up drafts. Without a key the rest of
# the CRM works and the AI endpoints return 503. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Leave empty to use the built-in default (openai/gpt-oss-120b). The model must
# support tool calling and JSON mode.
GROQ_MODEL=

# --- Production security (only read when DJANGO_DEBUG=False) ------------------
# Redirect HTTP to HTTPS. Set False if TLS is terminated by a proxy that already redirects.
# DJANGO_SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds. Start low; raise (e.g. 31536000) once HTTPS is confirmed working.
# DJANGO_HSTS_SECONDS=3600
