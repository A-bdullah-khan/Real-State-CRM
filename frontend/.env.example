# =============================================================================
# Frontend environment — copy to `frontend/.env` and adjust as needed.
#   cp .env.example .env
# Every value here has a working default, so the file is optional for local dev.
#
# Vite inlines VITE_* variables into the JavaScript bundle at build time:
#   - they are PUBLIC: never put secrets (API keys, tokens) here;
#   - changing them requires a rebuild / dev-server restart.
# =============================================================================

# --- API ---------------------------------------------------------------------
# Base URL the browser uses for API calls. Keep "/api" in development so requests
# go through the Vite proxy; in production use the full URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Timeout for regular API requests, in milliseconds.
VITE_API_TIMEOUT=15000

# Timeout for AI chat and AI follow-up draft requests, in milliseconds. One chat
# message can trigger several LLM round-trips, so keep this well above VITE_API_TIMEOUT.
VITE_AI_TIMEOUT=120000

# --- Dev server (only read by vite.config.js during `npm run dev`) -------------
# Django server the dev proxy forwards /api requests to.
VITE_BACKEND_URL=http://127.0.0.1:8000
# Port for the Vite dev server. If you change it, add the new origin to the
# backend's CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS.
VITE_DEV_PORT=5173

# --- Display -----------------------------------------------------------------
# Name shown in the navbar.
VITE_APP_NAME=EstateFlow CRM

# ISO 4217 currency code used to format prices and budgets (e.g. USD, EUR, GBP).
VITE_CURRENCY=USD
